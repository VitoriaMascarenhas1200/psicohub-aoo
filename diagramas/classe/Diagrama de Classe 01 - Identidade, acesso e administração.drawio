        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Perfil {\n        +Long id\n        +NomePerfil nome\n        +String descricao\n    }\n    class Permissao {\n        +Long id\n        +String codigo\n        +String recurso\n        +OperacaoPermissao operacao\n    }\n    class Usuario {\n        +Long id\n        +String nome\n        +String email\n        +String senhaHash\n        +SituacaoUsuario situacao\n        +autenticar()\n        +inativar()\n    }\n    class AjustePermissao {\n        +Boolean concedida\n        +DateTime ajustadoEm\n    }\n    class ConviteAcesso {\n        +Long id\n        +TipoConviteAcesso tipo\n        +String tokenHash\n        +DateTime expiraEm\n        +DateTime utilizadoEm\n        +utilizar()\n    }\n    class RegistroAuditoria {\n        +Long id\n        +String acao\n        +String tipoObjeto\n        +Long objetoId\n        +DateTime dataHora\n        +String justificativa\n    }\n    class ConfiguracaoSistema {\n        +String chave\n        +String valor\n        +String descricao\n        +atualizarValor()\n    }\n\n    Perfil \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Usuario : possui\n    Perfil \&quot;0..*\&quot; --&gt; \&quot;0..*\&quot; Permissao : concede\n    Usuario \&quot;0..*\&quot; --&gt; \&quot;0..*\&quot; Permissao : ajustes\n    Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AjustePermissao : realiza\n    Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ConviteAcesso : recebe/cria\n    Usuario \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; RegistroAuditoria : autoriza\n    Usuario \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; ConfiguracaoSistema : atualiza&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="59aEWEObgqkhMxKKLwsJ-1">
