        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Psicologo {\n        +Long id\n        +String nome\n        +String registroProfissional\n        +SituacaoPsicologo situacao\n    }\n\n    class Cliente {\n        +Long id\n        +String nome\n        +String cpf\n        +SituacaoCliente situacao\n        +Integer nivelUrgencia\n    }\n\n    class Disponibilidade {\n        +Long id\n        +Integer diaSemana\n        +Time horario\n        +Time horaFim\n        +ModalidadeDisponibilidade modalidade\n        +Boolean ativa\n    }\n\n    class AreaAtuacao {\n        +Long id\n        +String nome\n        +String descricao\n        +Boolean ativa\n    }\n\n    class Agendamento {\n        +Long id\n        +DateTime dataHoraInicio\n        +DateTime dataHoraFim\n        +ModalidadeAgendamento modalidade\n        +SituacaoAgendamento situacao\n        +OrigemAgendamento origem\n        +Decimal valor\n        +confirmar()\n        +cancelar()\n    }\n\n    class Cancelamento {\n        +Long id\n        +TipoAutorCancelamento tipoAutor\n        +String motivo\n        +Integer antecedenciaMinHoras\n        +DateTime canceladoEm\n    }\n\n    class Atendimento {\n        +Long id\n        +ResultadoAtendimento resultado\n        +DateTime registradoEm\n    }\n\n    %% Relacionamentos originais\n    Psicologo \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Agendamento : atende\n    Cliente \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Agendamento : agenda\n    Psicologo \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Disponibilidade : possui\n    Psicologo \&quot;1..*\&quot; --&gt; \&quot;1\&quot; AreaAtuacao : atua em\n    AreaAtuacao \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Agendamento : classifica\n\n    %% Relacionamentos corrigidos (as linhas que faltavam)\n    Agendamento \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Cancelamento : possui\n    Agendamento \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Atendimento : gera&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="dhTvxen88BWutPXIHOfn-305">
