        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Cliente {\n        +Long id\n        +String nome\n        +String cpf\n        +SituacaoCliente situacao\n        +Integer nivelUrgencia\n    }\n    class Psicologo {\n        +Long id\n        +String nome\n        +String registroProfissional\n        +SituacaoPsicologo situacao\n    }\n    class AreaAtuacao {\n        +Long id\n        +String nome\n        +String descricao\n        +Boolean ativa\n    }\n    class Agendamento {\n        +Long id\n        +DateTime dataHoraInicio\n        +DateTime dataHoraFim\n        +ModalidadeAgendamento modalidade\n        +SituacaoAgendamento situacao\n        +OrigemAgendamento origem\n        +Decimal valor\n        +confirmar()\n        +cancelar()\n    }\n    class JanelaEspera {\n        +Long id\n        +Integer diaSemana\n        +Time horario\n        +Time horaFim\n    }\n    class ItemListaEspera {\n        +Long id\n        +ModalidadeItemListaEspera modalidade\n        +SituacaoItemListaEspera situacao\n        +Integer prioridadeManual\n        +DateTime entradaEm\n    }\n    class VagaLiberada {\n        +Long id\n        +ModalidadeVagaLiberada modalidade\n        +GatilhoVagaLiberada gatilho\n        +SituacaoVagaLiberada situacao\n        +DateTime liberadaEm\n        +abrirReencaixe()\n    }\n    class OfertaVaga {\n        +Long id\n        +Decimal pontuacao\n        +Decimal pontosTempoEspera\n        +Decimal pontosUrgencia\n        +Decimal pontosAderencia\n        +SituacaoOfertaVaga situacao\n        +DateTime expiraEm\n        +aceitar()\n        +recusar()\n    }\n\n    Psicologo \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Agendamento : atende\n    Cliente \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Agendamento : agenda\n    Psicologo \&quot;1\&quot; --&gt; \&quot;1..*\&quot; AreaAtuacao : atua em\n    AreaAtuacao \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Agendamento : classifica\n    Psicologo \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; JanelaEspera\n    Psicologo \&quot;0..*\&quot; --&gt; \&quot;0..*\&quot; ItemListaEspera : preferido\n    AreaAtuacao \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ItemListaEspera : área\n    VagaLiberada \&quot;1\&quot; --&gt; \&quot;0..*\&quot; OfertaVaga : gera\n    ItemListaEspera \&quot;1\&quot; --&gt; \&quot;0..*\&quot; OfertaVaga : recebe\n    OfertaVaga \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; Agendamento : aceite gera&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="oNZMop5CfEF0uUxW0fzQ-1">
