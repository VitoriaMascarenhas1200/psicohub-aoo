        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Organizacao {\n        +Long id\n        +String razaoSocial\n        +String nomeFantasia\n        +SituacaoOrganizacao situacao\n    }\n    class Cliente {\n        +Long id\n        +String nome\n        +String cpf\n        +SituacaoCliente situacao\n        +Integer nivelUrgencia\n    }\n    class PlanoAssinatura {\n        +Long id\n        +NomePlanoAssinatura nome\n        +Integer limitePsicologos\n        +Decimal valorMensal\n        +Integer diasTeste\n    }\n    class Assinatura {\n        +Long id\n        +SituacaoAssinatura situacao\n        +Date inicio\n        +Date fim\n        +cancelar()\n    }\n    class Fatura {\n        +Long id\n        +Decimal valorTotal\n        +Date vencimento\n        +SituacaoFatura situacao\n        +fechar()\n    }\n    class Cobranca {\n        +Long id\n        +TipoCobranca tipo\n        +Decimal valor\n        +Date vencimento\n        +SituacaoCobranca situacao\n    }\n    class Agendamento {\n        +Long id\n        +DateTime dataHoraInicio\n        +DateTime dataHoraFim\n        +ModalidadeAgendamento modalidade\n        +SituacaoAgendamento situacao\n        +OrigemAgendamento origem\n        +Decimal valor\n        +confirmar()\n        +cancelar()\n    }\n\n    Organizacao \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Fatura : pagadora\n    Organizacao \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Assinatura : contrata\n    Cliente \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Fatura : pagador\n    Cliente \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Agendamento : agenda\n    PlanoAssinatura \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Assinatura : define\n    Assinatura \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Agendamento : gera\n    Cobranca \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Assinatura : refere-se\n    Cobranca \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Agendamento : refere-se&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="q2KSckbQsg-m4IwyG_lF-1">
