        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Cobranca {\n        +Long id\n        +TipoCobranca tipo\n        +Decimal valor\n        +Date vencimento\n        +SituacaoCobranca situacao\n    }\n    class Pagamento {\n        +Long id\n        +MetodoPagamento metodo\n        +Decimal valor\n        +SituacaoPagamento situacao\n        +aprovar()\n    }\n    class RetornoProvedor {\n        +Long id\n        +String idEventoProvedor\n        +TipoRetornoProvedor tipo\n        +DateTime recebidoEm\n        +processarIdempotentemente()\n    }\n    class Cancelamento {\n        +Long id\n        +TipoAutorCancelamento tipoAutor\n        +String motivo\n        +Integer antecedenciaMinHoras\n        +DateTime canceladoEm\n    }\n    class Reembolso {\n        +Long id\n        +Decimal percentual\n        +Decimal valor\n        +SituacaoReembolso situacao\n        +solicitar()\n        +processar()\n    }\n    class FaixaReembolso {\n        +Long id\n        +CondicaoFaixaReembolso condicao\n        +Integer antecedenciaMinHoras\n        +Decimal percentual\n    }\n\n    %% Correção de ligação\n    FaixaReembolso \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reembolso : define regra para\n\n    Cobranca \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Pagamento : recebe\n    Pagamento \&quot;1\&quot; --&gt; \&quot;0..*\&quot; RetornoProvedor : confirma\n    Pagamento \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reembolso : origem financeira\n    Cancelamento \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reembolso : origina&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="bo4E2gMD2H_HzPJpV7XK-1">
