        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class FaixaReembolso {\n        +Long id\n        +CondicaoFaixaReembolso condicao\n        +Integer antecedenciaMinHoras\n        +Decimal percentual\n    }\n    class Usuario {\n        +Long id\n        +String nome\n        +String email\n        +String senhaHash\n        +SituacaoUsuario situacao\n        +autenticar()\n        +inativar()\n    }\n    class Psicologo {\n        +Long id\n        +String nome\n        +String registroProfissional\n        +SituacaoPsicologo situacao\n    }\n    class AreaAtuacao {\n        +Long id\n        +String nome\n        +String descricao\n        +Boolean ativa\n    }\n    class PrecoSessao {\n        +Long id\n        +Decimal valor\n        +Date vigenteDesde\n        +Date vigenteAte\n    }\n\n    %% Correção de ligação\n    PrecoSessao \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FaixaReembolso : possui faixas\n\n    Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Psicologo : conta de acesso\n    Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PrecoSessao : configura\n    Psicologo \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; PrecoSessao : restringe\n    Psicologo \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; AreaAtuacao : atua em\n    AreaAtuacao \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; PrecoSessao : restringe&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="al192Go327jkWCx_-DXY-1">
