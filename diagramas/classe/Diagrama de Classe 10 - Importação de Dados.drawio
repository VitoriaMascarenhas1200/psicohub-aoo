        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class RegistroImportado {\n        +Long id\n        +Integer numeroLinha\n        +Json dadosOriginais\n        +SituacaoRegistroImportado situacao\n    }\n    class InconsistenciaImportacao {\n        +Long id\n        +TipoInconsistenciaImportacao tipo\n        +String campo\n        +String descricao\n        +Boolean resolvida\n    }\n    class Cliente {\n        +Long id\n        +String nome\n        +String cpf\n        +SituacaoCliente situacao\n        +Integer nivelUrgencia\n    }\n    class Psicologo {\n        +Long id\n        +String nome\n        +String registroProfissional\n        +SituacaoPsicologo situacao\n    }\n    class Usuario {\n        +Long id\n        +String nome\n        +String email\n        +String senhaHash\n        +SituacaoUsuario situacao\n        +autenticar()\n        +inativar()\n    }\n    class SugestaoDuplicidade {\n        +Long id\n        +Decimal similaridade\n        +SituacaoSugestaoDuplicidade situacao\n        +decidir()\n    }\n    class LoteImportacao {\n        +Long id\n        +FormatoLoteImportacao formato\n        +TipoCadastroLoteImportacao tipoCadastro\n        +SituacaoLoteImportacao situacao\n        +validar()\n        +consolidar()\n    }\n\n    RegistroImportado \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Cliente : consolida em\n    RegistroImportado \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Psicologo : consolida em\n    RegistroImportado \&quot;1\&quot; --&gt; \&quot;0..*\&quot; InconsistenciaImportacao\n    Usuario \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Cliente : conta de acesso\n    Usuario \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Psicologo : conta de acesso\n    Usuario \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; InconsistenciaImportacao\n    Usuario \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; SugestaoDuplicidade : decide\n    Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; LoteImportacao : envia\n    SugestaoDuplicidade \&quot;0..*\&quot; ..&gt; \&quot;0..*\&quot; RegistroImportado : sugere&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="yL39UyI9jRRW_CA80w-7-1">
