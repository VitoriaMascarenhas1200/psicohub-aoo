        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class VagaLiberada {\n        +Long id\n        +ModalidadeVagaLiberada modalidade\n        +GatilhoVagaLiberada gatilho\n        +SituacaoVagaLiberada situacao\n        +DateTime liberadaEm\n        +abrirReencaixe()\n    }\n    class ItemListaEspera {\n        +Long id\n        +ModalidadeItemListaEspera modalidade\n        +SituacaoItemListaEspera situacao\n        +Integer prioridadeManual\n        +DateTime entradaEm\n    }\n    class OfertaVaga {\n        +Long id\n        +Decimal pontuacao\n        +Decimal pontosTempoEspera\n        +Decimal pontosUrgencia\n        +Decimal pontosAderencia\n        +SituacaoOfertaVaga situacao\n        +DateTime expiraEm\n        +aceitar()\n        +recusar()\n    }\n    class ServicoReencaixe {\n        +calcularPontuacoes()\n        +gerarOfertas()\n    }\n    class PoliticaPriorizacao {\n        +Long id\n        +String nome\n        +Decimal pesoTempoEspera\n        +Decimal pesoUrgencia\n        +Decimal pesoAderencia\n        +criarEstrategia() EstrategiaPriorizacao\n    }\n    class EstrategiaPriorizacao {\n        &lt;&lt;interface&gt;&gt;\n        +calcularPontuacao(item, vaga) Decimal\n    }\n    class PriorizacaoPadrao {\n        +calcularPontuacao(item, vaga) Decimal\n    }\n    class PriorizacaoComHistorico {\n        +calcularPontuacao(item, vaga) Decimal\n    }\n\n    %% Correções de ligações\n    ServicoReencaixe \&quot;1\&quot; --&gt; \&quot;0..*\&quot; OfertaVaga : cria\n    PoliticaPriorizacao \&quot;1\&quot; --&gt; \&quot;1\&quot; EstrategiaPriorizacao : utiliza\n\n    VagaLiberada \&quot;1\&quot; --&gt; \&quot;0..*\&quot; OfertaVaga : gera\n    ItemListaEspera \&quot;1\&quot; --&gt; \&quot;0..*\&quot; OfertaVaga : recebe\n    PoliticaPriorizacao \&quot;1\&quot; --&gt; \&quot;0..*\&quot; OfertaVaga : aplicada\n    EstrategiaPriorizacao &lt;|.. PriorizacaoPadrao\n    EstrategiaPriorizacao &lt;|.. PriorizacaoComHistorico\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="zCBxJ7t0GkGc4nWaC3Co-76">
