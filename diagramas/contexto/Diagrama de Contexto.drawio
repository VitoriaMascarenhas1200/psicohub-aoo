        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Atores Externos (Humanos)\n    Admin[\&quot; Administrador\&quot;]\n    Psi[\&quot; Psicólogo\&quot;]\n    Atend[\&quot; Atendente\&quot;]\n    Cliente[\&quot; Cliente/Paciente\&quot;]\n    \n    %% Fontes de Dados e Sistemas Externos\n    Legado[\&quot; Legado: CSV e XLSX\&quot;]\n    Pagamento[\&quot; Provedor de Pagamento: Pix e Cartão\&quot;]\n    Email[\&quot; Serviço Externo: e-mail\&quot;]\n\n    %% Fronteira do Sistema\n    subgraph Sistema [\&quot;SISTEMA DE GESTÃO DO PSICOHUB\&quot;]\n        direction TB\n        \n        %% Módulos do Sistema\n        M_Admin[\&quot;Administração\&quot;]\n        M_Psi[\&quot;Psicólogos\&quot;]\n        M_Agenda[\&quot;Agenda\&quot;]\n        M_Atend[\&quot;Atendimento\&quot;]\n        M_Notif[\&quot;Notificações\&quot;]\n        M_Fin[\&quot;Financeiro\&quot;]\n        M_Clientes[\&quot;Clientes/Pacientes\&quot;]\n        M_Acesso[\&quot;Identidade e Acesso\&quot;]\n        M_Espera[\&quot;Lista de Espera e Reencaixe\&quot;]\n        M_Import[\&quot;Organização e Importação de Dados\&quot;]\n        \n        %% Componente Interno (Temporizador corrigido)\n        Scheduler((\&quot; Scheduler Interno\\nExpiração, Reenvio, Lembretes\&quot;))\n        \n        %% Relacionamentos Internos do Scheduler\n        Scheduler -.-&gt; M_Notif\n        Scheduler -.-&gt; M_Fin\n    end\n\n    %% Fluxos dos Atores para o Sistema\n    Admin --&gt;|\&quot;Comandos de gestão,\\npainéis, relatórios\&quot;| Sistema\n    Psi --&gt;|\&quot;Disponibilidade,\\nagenda e vínculos\&quot;| Sistema\n    Atend --&gt;|\&quot;Cadastros,\\nagendamentos, fila\&quot;| Sistema\n    Cliente --&gt;|\&quot;Agendamento,\\nrespostas, notificações\&quot;| Sistema\n    \n    %% Fluxos de Dados Externos\n    Legado --&gt;|\&quot;Arquivos de importação\&quot;| M_Import\n    \n    %% Fluxos de Saída para Sistemas Externos\n    M_Fin --&gt;|\&quot;Solicitação de\\ncobrança/reembolso\&quot;| Pagamento\n    Pagamento --&gt;|\&quot;Confirmação\\nou falha\&quot;| M_Fin\n    \n    M_Notif --&gt;|\&quot;Destinatário,\\nassunto, conteúdo\&quot;| Email\n\n    %% Estilização de Alto Contraste\n    classDef ator fill:#1e3a8a,stroke:#60a5fa,stroke-width:2px,color:#ffffff;\n    classDef externo fill:#7f1d1d,stroke:#f87171,stroke-width:2px,color:#ffffff;\n    classDef legado fill:#4c1d95,stroke:#a78bfa,stroke-width:2px,color:#ffffff;\n    classDef sistema fill:#111827,stroke:#9ca3af,stroke-width:3px,stroke-dasharray: 5 5,color:#ffffff;\n    classDef modulo fill:#064e3b,stroke:#34d399,stroke-width:2px,color:#ffffff;\n    classDef scheduler fill:#78350f,stroke:#fbbf24,stroke-width:2px,color:#ffffff;\n\n    class Admin,Psi,Atend,Cliente ator;\n    class Pagamento,Email externo;\n    class Legado legado;\n    class Sistema sistema;\n    class M_Admin,M_Psi,M_Agenda,M_Atend,M_Notif,M_Fin,M_Clientes,M_Acesso,M_Espera,M_Import modulo;\n    class Scheduler scheduler;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="66Ktqb2Hf25mgSQRB7Yc-1">
