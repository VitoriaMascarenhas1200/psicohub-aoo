        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Identidade, Acesso e Administração\n    perfil { bigint id PK }\n    permissao { bigint id PK }\n    usuario { bigint id PK }\n    perfil_permissao { bigint perfil_id PK,FK }\n    usuario_permissao { bigint usuario_id PK,FK }\n    convite_acesso { bigint id PK }\n    registro_auditoria { bigint id PK }\n    configuracao_sistema { varchar chave PK }\n\n    perfil ||--o{ usuario : \&quot;perfil_id\&quot;\n    perfil ||--o{ perfil_permissao : \&quot;perfil_id\&quot;\n    permissao ||--o{ perfil_permissao : \&quot;permissao_id\&quot;\n    usuario ||--o{ usuario_permissao : \&quot;usuario_id\&quot;\n    permissao ||--o{ usuario_permissao : \&quot;permissao_id\&quot;\n    usuario ||--o{ convite_acesso : \&quot;usuario_id\&quot;\n    usuario ||--o{ registro_auditoria : \&quot;autor_id\&quot;\n    usuario ||--o{ configuracao_sistema : \&quot;atualizado_por_id\&quot;\n\n    %% Cadastros (Psicólogos e Clientes)\n    area_atuacao { bigint id PK }\n    psicologo { bigint id PK }\n    psicologo_area_atuacao { bigint psicologo_id PK,FK }\n    cliente { bigint id PK }\n    vinculo { bigint id PK }\n\n    usuario ||--o| psicologo : \&quot;usuario_id\&quot;\n    usuario ||--o| cliente : \&quot;usuario_id\&quot;\n    psicologo ||--o{ psicologo_area_atuacao : \&quot;psicologo_id\&quot;\n    area_atuacao ||--o{ psicologo_area_atuacao : \&quot;area_atuacao_id\&quot;\n    psicologo ||--o{ vinculo : \&quot;psicologo_id\&quot;\n    cliente ||--o{ vinculo : \&quot;cliente_id\&quot;\n\n    %% Agenda e Atendimento\n    disponibilidade { bigint id PK }\n    agendamento { bigint id PK }\n    cancelamento { bigint id PK }\n    atendimento { bigint id PK }\n\n    psicologo ||--o{ disponibilidade : \&quot;psicologo_id\&quot;\n    psicologo ||--o{ agendamento : \&quot;psicologo_id\&quot;\n    cliente ||--o{ agendamento : \&quot;cliente_id\&quot;\n    area_atuacao ||--o{ agendamento : \&quot;area_atuacao_id\&quot;\n    agendamento ||--o| cancelamento : \&quot;agendamento_id\&quot;\n    agendamento ||--o| atendimento : \&quot;agendamento_id\&quot;\n\n    %% Lista de Espera e Reencaixe\n    politica_priorizacao { bigint id PK }\n    item_lista_espera { bigint id PK }\n    janela_espera { bigint id PK }\n    vaga_liberada { bigint id PK }\n    oferta_vaga { bigint id PK }\n\n    usuario ||--o{ politica_priorizacao : \&quot;criada_por_id\&quot;\n    cliente ||--o{ item_lista_espera : \&quot;cliente_id\&quot;\n    area_atuacao ||--o{ item_lista_espera : \&quot;area_atuacao_id\&quot;\n    psicologo ||--o{ item_lista_espera : \&quot;psicologo_id\&quot;\n    item_lista_espera ||--o{ janela_espera : \&quot;item_id\&quot;\n    psicologo ||--o{ vaga_liberada : \&quot;psicologo_id\&quot;\n    area_atuacao ||--o{ vaga_liberada : \&quot;area_atuacao_id\&quot;\n    agendamento ||--o| vaga_liberada : \&quot;agendamento_origem_id\&quot;\n    vaga_liberada ||--o{ oferta_vaga : \&quot;vaga_id\&quot;\n    item_lista_espera ||--o{ oferta_vaga : \&quot;item_id\&quot;\n    politica_priorizacao ||--o{ oferta_vaga : \&quot;politica_id\&quot;\n    agendamento ||--o| oferta_vaga : \&quot;agendamento_id\&quot;\n\n    %% Notificações\n    notificacao { bigint id PK }\n    preferencia_notificacao { bigint usuario_id PK,FK }\n    envio_email { bigint id PK }\n\n    usuario ||--o{ notificacao : \&quot;usuario_id\&quot;\n    usuario ||--o{ preferencia_notificacao : \&quot;usuario_id\&quot;\n    notificacao ||--o{ envio_email : \&quot;notificacao_id\&quot;\n    usuario ||--o{ envio_email : \&quot;usuario_id\&quot;\n\n    %% Financeiro e Assinatura\n    organizacao { bigint id PK }\n    plano_assinatura { bigint id PK }\n    assinatura { bigint id PK }\n    fatura { bigint id PK }\n    cobranca { bigint id PK }\n    pagamento { bigint id PK }\n    retorno_provedor { bigint id PK }\n    reembolso { bigint id PK }\n    preco_sessao { bigint id PK }\n    faixa_reembolso { bigint id PK }\n\n    organizacao ||--o{ assinatura : \&quot;organizacao_id\&quot;\n    plano_assinatura ||--o{ assinatura : \&quot;plano_id\&quot;\n    cliente ||--o{ fatura : \&quot;cliente_id\&quot;\n    organizacao ||--o{ fatura : \&quot;organizacao_id\&quot;\n    fatura ||--o{ cobranca : \&quot;fatura_id\&quot;\n    agendamento ||--o{ cobranca : \&quot;agendamento_id\&quot;\n    assinatura ||--o{ cobranca : \&quot;assinatura_id\&quot;\n    cobranca ||--o{ pagamento : \&quot;cobranca_id\&quot;\n    pagamento ||--o{ retorno_provedor : \&quot;pagamento_id\&quot;\n    pagamento ||--o{ reembolso : \&quot;pagamento_id\&quot;\n    cancelamento ||--o| reembolso : \&quot;cancelamento_id\&quot;\n    psicologo ||--o{ preco_sessao : \&quot;psicologo_id\&quot;\n    area_atuacao ||--o{ preco_sessao : \&quot;area_atuacao_id\&quot;\n    usuario ||--o{ preco_sessao : \&quot;criado_por_id\&quot;\n\n    %% Importação de Dados\n    lote_importacao { bigint id PK }\n    registro_importado { bigint id PK }\n    inconsistencia_importacao { bigint id PK }\n    sugestao_duplicidade { bigint id PK }\n\n    usuario ||--o{ lote_importacao : \&quot;responsavel_id\&quot;\n    lote_importacao ||--o{ registro_importado : \&quot;lote_id\&quot;\n    cliente ||--o{ registro_importado : \&quot;cliente_id\&quot;\n    psicologo ||--o{ registro_importado : \&quot;psicologo_id\&quot;\n    registro_importado ||--o{ inconsistencia_importacao : \&quot;registro_id\&quot;\n    usuario ||--o{ inconsistencia_importacao : \&quot;resolvida_por_id\&quot;\n    registro_importado ||--o{ sugestao_duplicidade : \&quot;registro_id\&quot;\n    cliente ||--o{ sugestao_duplicidade : \&quot;cliente_existente_id\&quot;\n    psicologo ||--o{ sugestao_duplicidade : \&quot;psicologo_existente_id\&quot;\n    usuario ||--o{ sugestao_duplicidade : \&quot;decidida_por_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="PnQja17u5HhUQRtXXXfG-1220">
