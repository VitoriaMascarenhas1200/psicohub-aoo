        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    perfil {\n        bigint id PK\n        varchar nome UK\n        varchar descricao\n    }\n\n    perfil_permissao {\n        bigint perfil_id PK,FK\n        bigint permissao_id PK,FK\n    }\n\n    permissao {\n        bigint id PK\n        varchar codigo UK\n        varchar recurso\n        enum operacao\n        varchar descricao\n    }\n\n    usuario {\n        bigint id PK\n        bigint perfil_id FK\n        varchar nome\n        varchar email UK\n        varchar senha_hash\n        enum situacao\n        datetime ultimo_acesso_em\n        datetime criado_em\n        datetime atualizado_em\n    }\n\n    usuario_permissao {\n        bigint usuario_id PK,FK\n        bigint permissao_id PK,FK\n        tinyint concedida\n        bigint ajustado_por_id FK\n        datetime ajustado_em\n    }\n\n    convite_acesso {\n        bigint id PK\n        bigint usuario_id FK\n        enum tipo\n        char token_hash UK\n        datetime expira_em\n        datetime utilizado_em\n        bigint criado_por_id FK\n        datetime criado_em\n    }\n\n    registro_auditoria {\n        bigint id PK\n        bigint autor_id FK\n        varchar acao\n        varchar tipo_objeto\n        bigint objeto_id\n        datetime data_hora\n        varchar justificativa\n        json detalhes\n    }\n\n    configuracao_sistema {\n        varchar chave PK\n        varchar valor\n        varchar descricao\n        bigint atualizado_por_id FK\n        datetime atualizado_em\n    }\n\n    %% Relacionamentos\n    perfil ||--o{ usuario : \&quot;atribui\&quot;\n    perfil ||--o{ perfil_permissao : \&quot;possui\&quot;\n    permissao ||--o{ perfil_permissao : \&quot;integra\&quot;\n    usuario ||--o{ usuario_permissao : \&quot;possui\&quot;\n    permissao ||--o{ usuario_permissao : \&quot;concede\&quot;\n    usuario ||--o{ convite_acesso : \&quot;gera\&quot;\n    usuario ||--o{ registro_auditoria : \&quot;registra\&quot;\n    usuario ||--o{ usuario_permissao : \&quot;ajusta\&quot;\n    usuario ||--o{ convite_acesso : \&quot;cria\&quot;\n    usuario ||--o{ configuracao_sistema : \&quot;atualiza\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="rrXu7gBR4aztzJJX4not-197">
