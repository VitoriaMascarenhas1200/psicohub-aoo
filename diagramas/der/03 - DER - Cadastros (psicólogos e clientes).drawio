        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    usuario {\n        bigint id PK\n    }\n\n    psicologo {\n        bigint id PK\n        bigint usuario_id UK,FK\n        string nome\n        string registro_profissional UK\n        string email_contato\n        string telefone\n        string situacao\n        datetime criado_em\n        datetime atualizado_em\n    }\n\n    cliente {\n        bigint id PK\n        bigint usuario_id UK,FK\n        string nome\n        string cpf UK\n        date data_nascimento\n        string email\n        string telefone\n        string nome_responsavel\n        string contato_responsavel\n        string situacao\n        tinyint nivel_urgencia\n        datetime criado_em\n        datetime atualizado_em\n    }\n\n    area_atuacao {\n        bigint id PK\n        string nome UK\n        string descricao\n        tinyint ativa\n    }\n\n    psicologo_area_atuacao {\n        bigint psicologo_id PK,FK\n        bigint area_atuacao_id PK,FK\n    }\n\n    vinculo {\n        bigint id PK\n        bigint psicologo_id FK\n        bigint cliente_id FK\n        date data_inicio\n        date data_fim\n        string situacao\n        tinyint chave_ativo\n    }\n\n    %% Relacionamentos principais e as ligações que faltavam:\n    usuario ||--o| psicologo : \&quot;possui\&quot;\n    usuario ||--o| cliente : \&quot;possui\&quot;\n    \n    psicologo ||--o{ psicologo_area_atuacao : \&quot;\&quot;\n    area_atuacao ||--o{ psicologo_area_atuacao : \&quot;\&quot;\n    \n    psicologo ||--o{ vinculo : \&quot;\&quot;\n    cliente ||--o{ vinculo : \&quot;\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="50t_58ATYs7xTngJJo7R-901">
