        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    psicologo {\n        bigint id PK\n    }\n\n    cliente {\n        bigint id PK\n    }\n\n    area_atuacao {\n        bigint id PK\n    }\n\n    disponibilidade {\n        bigint id PK\n        bigint psicologo_id FK\n        tinyint dia_semana\n        time hora_inicio\n        time hora_fim\n        enum modalidade\n        tinyint ativa\n        datetime criado_em\n    }\n    \n    agendamento {\n        bigint id PK\n        bigint psicologo_id FK\n        bigint cliente_id FK\n        bigint area_atuacao_id FK\n        datetime data_hora_inicio\n        datetime data_hora_fim\n        enum modalidade\n        enum situacao\n        enum origem\n        decimal valor\n        datetime reserva_expira_em\n        datetime confirmado_em\n        bigint criado_por_id FK\n        datetime criado_em\n        datetime atualizado_em\n        tinyint chave_ativo\n    }\n    \n    cancelamento {\n        bigint id PK\n        bigint agendamento_id UK,FK\n        bigint autor_id FK\n        enum tipo_autor\n        datetime data_hora\n        varchar motivo\n        decimal antecedencia_horas\n    }\n    \n    atendimento {\n        bigint id PK\n        bigint agendamento_id UK,FK\n        enum resultado\n        bigint registrado_por_id FK\n        datetime registrado_em\n        varchar observacao_administrativa\n    }\n\n    %% Relacionamentos existentes\n    agendamento ||--o| cancelamento : \&quot;agendamento_id\&quot;\n    agendamento ||--o| atendimento : \&quot;agendamento_id\&quot;\n\n    %% Ligações que estavam faltando adicionadas abaixo:\n    psicologo ||--o{ disponibilidade : \&quot;psicologo_id\&quot;\n    psicologo ||--o{ agendamento : \&quot;psicologo_id\&quot;\n    cliente ||--o{ agendamento : \&quot;cliente_id\&quot;\n    area_atuacao ||--o{ agendamento : \&quot;area_atuacao_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Yq2y1m5wUM-xQi5KpqLy-156">
