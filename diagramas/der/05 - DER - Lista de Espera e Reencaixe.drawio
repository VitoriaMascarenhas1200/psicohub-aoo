        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    usuario {\n        bigint id PK\n    }\n\n    psicologo {\n        bigint id PK\n    }\n\n    cliente {\n        bigint id PK\n    }\n\n    area_atuacao {\n        bigint id PK\n    }\n\n    agendamento {\n        bigint id PK\n    }\n\n    politica_priorizacao {\n        bigint id PK\n        varchar nome\n        varchar estrategia\n        decimal peso_tempo_espera\n        decimal peso_urgencia\n        decimal peso_aderencia\n        decimal peso_historico\n        tinyint usa_historico\n        tinyint vigente\n        bigint criada_por_id FK\n        datetime criada_em\n        tinyint chave_vigente UK\n    }\n\n    item_lista_espera {\n        bigint id PK\n        bigint cliente_id FK\n        bigint area_atuacao_id FK\n        bigint psicologo_id FK\n        enum modalidade\n        enum situacao\n        datetime entrada_em\n        smallint posicao_manual\n        datetime saida_em\n        tinyint chave_ativo\n    }\n\n    janela_espera {\n        bigint id PK\n        bigint item_id FK\n        tinyint dia_semana\n        time hora_inicio\n        time hora_fim\n    }\n\n    vaga_liberada {\n        bigint id PK\n        bigint psicologo_id FK\n        bigint area_atuacao_id FK\n        datetime data_hora_inicio\n        datetime data_hora_fim\n        enum modalidade\n        enum gatilho\n        bigint agendamento_origem_id FK\n        enum situacao\n        datetime liberada_em\n        datetime encerrada_em\n    }\n\n    oferta_vaga {\n        bigint id PK\n        bigint vaga_id FK\n        bigint item_id FK\n        bigint politica_id FK\n        decimal pontuacao\n        decimal pontos_tempo_espera\n        decimal pontos_urgencia\n        decimal pontos_aderencia\n        decimal pontos_historico\n        smallint posicao_na_fila\n        enum situacao\n        datetime ofertada_em\n        datetime expira_em\n        datetime respondida_em\n        bigint agendamento_id UK,FK\n        tinyint chave_aberta\n    }\n\n    %% Relacionamentos existentes\n    item_lista_espera ||--o{ janela_espera : \&quot;item_id\&quot;\n    vaga_liberada ||--o{ oferta_vaga : \&quot;vaga_id\&quot;\n    item_lista_espera ||--o{ oferta_vaga : \&quot;item_id\&quot;\n    politica_priorizacao ||--o{ oferta_vaga : \&quot;politica_id\&quot;\n\n    %% Ligações que estavam faltando adicionadas abaixo:\n    usuario ||--o{ politica_priorizacao : \&quot;criada_por_id\&quot;\n    cliente ||--o{ item_lista_espera : \&quot;cliente_id\&quot;\n    area_atuacao ||--o{ item_lista_espera : \&quot;area_atuacao_id\&quot;\n    psicologo ||--o{ item_lista_espera : \&quot;psicologo_id\&quot;\n    psicologo ||--o{ vaga_liberada : \&quot;psicologo_id\&quot;\n    area_atuacao ||--o{ vaga_liberada : \&quot;area_atuacao_id\&quot;\n    agendamento ||--o{ vaga_liberada : \&quot;agendamento_origem_id\&quot;\n    agendamento ||--o| oferta_vaga : \&quot;agendamento_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="DZOKmXCC8Tzpqyvbn9f7-223">
