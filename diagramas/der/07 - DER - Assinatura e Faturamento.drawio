        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    cliente {\n        bigint id PK\n    }\n\n    agendamento {\n        bigint id PK\n    }\n\n    organizacao {\n        bigint id PK\n        varchar razao_social\n        varchar nome_fantasia\n        char cnpj UK\n        varchar email_contato\n        enum situacao\n        datetime criado_em\n    }\n    \n    plano_assinatura {\n        bigint id PK\n        enum nome UK\n        smallint limite_psicologos\n        decimal valor_mensal\n        tinyint dias_teste\n        tinyint dias_arrependimento\n        tinyint ativo\n    }\n    \n    assinatura {\n        bigint id PK\n        bigint organizacao_id FK\n        bigint plano_id FK\n        enum situacao\n        date inicio_em\n        date fim_teste_em\n        date ciclo_inicio\n        date ciclo_fim\n        date proxima_cobranca_em\n        datetime cancelamento_solicitado_em\n        datetime criada_em\n    }\n    \n    fatura {\n        bigint id PK\n        varchar numero UK\n        bigint cliente_id FK\n        bigint organizacao_id FK\n        decimal valor_total\n        datetime emitida_em\n        datetime vencimento\n        enum situacao\n    }\n    \n    cobranca {\n        bigint id PK\n        bigint fatura_id FK\n        enum tipo\n        bigint agendamento_id FK\n        bigint assinatura_id FK\n        varchar descricao\n        decimal valor\n        datetime vencimento\n        enum situacao\n        datetime criada_em\n    }\n\n    %% Relacionamentos existentes\n    organizacao ||--o{ assinatura : \&quot;organizacao_id\&quot;\n    plano_assinatura ||--o{ assinatura : \&quot;plano_id\&quot;\n    organizacao ||--o{ fatura : \&quot;organizacao_id\&quot;\n    fatura ||--o{ cobranca : \&quot;fatura_id\&quot;\n    assinatura ||--o{ cobranca : \&quot;assinatura_id\&quot;\n\n    %% Ligações que estavam faltando adicionadas abaixo:\n    cliente ||--o{ fatura : \&quot;cliente_id\&quot;\n    agendamento ||--o{ cobranca : \&quot;agendamento_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="FsMTYM2oXO1fdMdTIWHd-181">
