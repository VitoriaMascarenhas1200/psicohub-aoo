        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    cobranca {\n        bigint id PK\n    }\n\n    cancelamento {\n        bigint id PK\n    }\n\n    pagamento {\n        bigint id PK\n        bigint cobranca_id FK\n        enum metodo\n        decimal valor\n        enum situacao\n        varchar id_transacao_provedor UK\n        datetime criado_em\n        datetime pago_em\n    }\n    \n    retorno_provedor {\n        bigint id PK\n        varchar id_evento_provedor UK\n        enum tipo\n        bigint pagamento_id FK\n        json payload\n        datetime recebido_em\n        datetime processado_em\n    }\n    \n    reembolso {\n        bigint id PK\n        bigint pagamento_id FK\n        bigint cancelamento_id UK,FK\n        decimal percentual\n        decimal valor\n        enum situacao\n        varchar id_reembolso_provedor UK\n        datetime solicitado_em\n        datetime processado_em\n    }\n\n    %% Relacionamentos existentes\n    cobranca ||--o{ pagamento : \&quot;cobranca_id\&quot;\n    pagamento ||--o{ retorno_provedor : \&quot;pagamento_id\&quot;\n    pagamento ||--o{ reembolso : \&quot;pagamento_id\&quot;\n    cancelamento ||--o| reembolso : \&quot;cancelamento_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="1d4HfSF2AYwaw4X6Rfce-106">
