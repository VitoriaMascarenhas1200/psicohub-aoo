        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    usuario {\n        bigint id PK\n    }\n\n    cliente {\n        bigint id PK\n    }\n\n    psicologo {\n        bigint id PK\n    }\n\n    lote_importacao {\n        bigint id PK\n        bigint responsavel_id FK\n        varchar nome_arquivo\n        enum formato\n        enum tipo_cadastro\n        enum situacao\n        int total_registros\n        int total_validos\n        int total_inconsistentes\n        int total_duplicidades\n        datetime importado_em\n        datetime consolidado_em\n    }\n    \n    registro_importado {\n        bigint id PK\n        bigint lote_id FK\n        int numero_linha\n        json dados_originais\n        json dados_higienizados\n        enum situacao\n        bigint cliente_id FK\n        bigint psicologo_id FK\n    }\n    \n    inconsistencia_importacao {\n        bigint id PK\n        bigint registro_id FK\n        varchar campo\n        enum tipo\n        varchar descricao\n        varchar valor_original\n        tinyint resolvida\n        bigint resolvida_por_id FK\n        datetime resolvida_em\n    }\n    \n    sugestao_duplicidade {\n        bigint id PK\n        bigint registro_id FK\n        bigint registro_duplicado_id FK\n        bigint cliente_existente_id FK\n        bigint psicologo_existente_id FK\n        decimal similaridade\n        enum situacao\n        bigint decidida_por_id FK\n        datetime decidida_em\n    }\n\n    %% Relacionamentos existentes\n    usuario ||--o{ lote_importacao : \&quot;responsavel_id\&quot;\n    lote_importacao ||--o{ registro_importado : \&quot;lote_id\&quot;\n    registro_importado ||--o{ inconsistencia_importacao : \&quot;registro_id\&quot;\n    registro_importado ||--o{ sugestao_duplicidade : \&quot;registro_id\&quot;\n    registro_importado ||--o| cliente : \&quot;cliente_id\&quot;\n    registro_importado ||--o| psicologo : \&quot;psicologo_id\&quot;\n\n    %% Ligações que estavam faltando adicionadas abaixo:\n    usuario ||--o{ inconsistencia_importacao : \&quot;resolvida_por_id\&quot;\n    usuario ||--o{ sugestao_duplicidade : \&quot;decidida_por_id\&quot;\n    registro_importado ||--o{ sugestao_duplicidade : \&quot;registro_duplicado_id\&quot;\n    cliente ||--o{ sugestao_duplicidade : \&quot;cliente_existente_id\&quot;\n    psicologo ||--o{ sugestao_duplicidade : \&quot;psicologo_existente_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="aQooNtOxxrevfdmXAw4p-1">
